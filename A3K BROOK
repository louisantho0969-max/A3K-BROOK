-- ==================== CRÉATION DU CADDIE ====================
local function createCart()
	-- Supprime l'ancien s'il existe
	for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
		if item.Name == "Shopping Cart" then item:Destroy() end
	end
	if character then
		for _, item in pairs(character:GetChildren()) do
			if item.Name == "Shopping Cart" then item:Destroy() end
		end
	end

	local tool = Instance.new("Tool")
	tool.Name = "Shopping Cart"
	tool.RequiresHandle = true
	tool.CanBeDropped = true
	tool.ToolTip = "Caddie"
	tool.Grip = CFrame.new(0, -1.5, 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(3.2, 2, 4.5)
	handle.BrickColor = BrickColor.new("Medium stone grey")
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local mesh = Instance.new("SpecialMesh", handle)
	mesh.MeshType = Enum.MeshType.Brick

	-- Siège
	local seat = Instance.new("Seat")
	seat.Name = "CartSeat"
	seat.Size = Vector3.new(2, 0.3, 2)
	seat.BrickColor = BrickColor.new("Black")
	seat.Material = Enum.Material.SmoothPlastic
	seat.CanCollide = false
	seat.Parent = tool

	local seatWeld = Instance.new("Weld")
	seatWeld.Part0 = handle
	seatWeld.Part1 = seat
	seatWeld.C0 = CFrame.new(0, -0.5, 0.7)
	seatWeld.Parent = seat

	tool.Parent = LocalPlayer.Backpack
	return tool
end

-- ==================== FLING AVEC CADDIE ====================
local function flingWithCart(target)
	if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
		warn("Joueur invalide")
		return
	end
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end

	local originalCFrame = character.HumanoidRootPart.CFrame
	local targetHRP = target.Character.HumanoidRootPart
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	-- 1. Créer et équiper le caddie
	local cart = createCart()
	humanoid:EquipTool(cart)
	task.wait(0.15)

	-- 2. Tourner très vite autour du joueur ciblé avec le caddie
	local start = tick()
	while tick() - start < 1.5 do
		if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then break end
		local offset = Vector3.new(
			math.random(-9, 9),
			math.random(0, 4),
			math.random(-9, 9)
		)
		character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(offset)
		task.wait(0.025)
	end

	-- 3. Téléportation sous la map
	character.HumanoidRootPart.CFrame = CFrame.new(0, -500, 0)
	task.wait(0.45)

	-- 4. Enlever le caddie (il tombe → fling)
	humanoid:UnequipTools()
	if cart and cart.Parent then
		cart:Destroy()
	end

	task.wait(0.3)

	-- 5. Te remettre à ta position d'origine
	if character and character:FindFirstChild("HumanoidRootPart") then
		character.HumanoidRootPart.CFrame = originalCFrame
	end

	print("Fling avec caddie terminé sur : " .. target.Name)
end

