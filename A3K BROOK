end)

createButton(pages.Troll, "Bring Closest", function()
	local closest, shortest = nil, math.huge
	local myPos = character and character.HumanoidRootPart and character.HumanoidRootPart.Position
	if not myPos then return end
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local d = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
			if d < shortest then
				shortest = d
				closest = plr
			end
		end
	end
	if closest then
		closest.Character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -4)
	end
end)

-- Options de base
createToggle(pages.Player, "Invisible", false, function(v)
	if character then
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.Transparency = v and 1 or 0
			elseif part:IsA("Decal") then
				part.Transparency = v and 1 or 0
			end
		end
	end
end)

createToggle(pages.Movement, "Noclip", false, function(v)
	if v then
		RunService:BindToRenderStep("Noclip", 1, function()
			if character then
				for _, part in pairs(character:GetDescendants()) do
					if part:IsA("BasePart") then part.CanCollide = false end
				end
			end
		end)
	else
		RunService:UnbindFromRenderStep("Noclip")
	end
end)

