end

local function createToggle(parent, text, default, callback)
	local frame = Instance.new("Frame", parent)
	frame.BackgroundColor3 = Color3.fromRGB(12, 18, 15)
	frame.BackgroundTransparency = 0.3
	frame.Size = UDim2.new(1, -10, 0, 42)
	frame.BorderSizePixel = 0
	frame.ZIndex = 3
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

	local label = Instance.new("TextLabel", frame)
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 12, 0, 0)
	label.Size = UDim2.new(0.7, 0, 1, 0)
	label.Font = Enum.Font.Gotham
	label.Text = text
	label.TextColor3 = Color3.fromRGB(200, 255, 220)
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 4

	local toggle = Instance.new("TextButton", frame)
	toggle.BackgroundColor3 = default and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(40, 50, 45)
	toggle.Position = UDim2.new(1, -55, 0.5, -12)
	toggle.Size = UDim2.new(0, 45, 0, 24)
	toggle.Text = ""
	toggle.AutoButtonColor = false
	toggle.ZIndex = 4
	Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

	local circle = Instance.new("Frame", toggle)
	circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	circle.Position = default and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
	circle.Size = UDim2.new(0, 18, 0, 18)
	circle.BorderSizePixel = 0
	circle.ZIndex = 5
	Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

	local state = default
	toggle.MouseButton1Click:Connect(function()
		state = not state
		toggle.BackgroundColor3 = state and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(40, 50, 45)
		circle:TweenPosition(state and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 3, 0.5, -9), "Out", "Quad", 0.15, true)
		callback(state)
	end)
end

