local function createTab(name, index)
	local btn = Instance.new("TextButton", Sidebar)
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	btn.BackgroundTransparency = index == 1 and 0.2 or 0.6
	btn.Position = UDim2.new(0, 8, 0, 10 + (index-1)*36)
	btn.Size = UDim2.new(1, -16, 0, 32)
	btn.Font = Enum.Font.GothamSemibold
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(0, 255, 140)
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.ZIndex = 3
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	tabButtons[name] = btn

	local page = Instance.new("ScrollingFrame", Main)
	page.BackgroundTransparency = 1
	page.Position = UDim2.new(0, 140, 0, 58)
	page.Size = UDim2.new(1, -150, 1, -68)
	page.CanvasSize = UDim2.new(0, 0, 0, 700)
	page.ScrollBarThickness = 4
	page.Visible = index == 1
	page.BorderSizePixel = 0
	page.ZIndex = 2
	Instance.new("UIListLayout", page).Padding = UDim.new(0, 8)
	pages[name] = page

	btn.MouseButton1Click:Connect(function()
		for n, p in pairs(pages) do
			p.Visible = (n == name)
			tabButtons[n].BackgroundTransparency = (n == name) and 0.2 or 0.6
		end
	end)
end

for i, name in ipairs(tabs) do createTab(name, i) end

