-- ========== FLING CADDIE METHOD ==========
local function flingWithCart(target)
	if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
		warn("Joueur invalide")
		return
	end
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end

	local originalCFrame = character.HumanoidRootPart.CFrame
	local targetHRP = target.Character.HumanoidRootPart

	-- 1. Rendre invisible
	for _, v in pairs(character:GetDescendants()) do
		if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
			v.Transparency = 1
		elseif v:IsA("Decal") then
			v.Transparency = 1
		end
	end

	-- 2. Essayer de trouver / créer un caddie (Shopping Cart)
	local cart = nil
	-- Méthode courante : chercher un outil Shopping Cart ou en forcer un
	for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
		if tool.Name:lower():find("cart") or tool.Name:lower():find("shopping") then
			cart = tool
			break
		end
	end

	if not cart then
		-- Création d'un faux caddie simple (fallback)
		cart = Instance.new("Tool")
		cart.Name = "Shopping Cart"
		cart.RequiresHandle = false
		local handle = Instance.new("Part")
		handle.Name = "Handle"
		handle.Size = Vector3.new(2, 2, 4)
		handle.Transparency = 1
		handle.Parent = cart
		cart.Parent = LocalPlayer.Backpack
	end

	-- Équiper le caddie
	character.Humanoid:EquipTool(cart)

	-- 3. Bouger autour du joueur ciblé rapidement
	local startTime = tick()
	while tick() - startTime < 1.2 do
		if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
			local offset = Vector3.new(math.random(-8, 8), math.random(0, 4), math.random(-8, 8))
			character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(offset)
		end
		task.wait(0.03)
	end

	-- 4. Téléportation sous la map
	character.HumanoidRootPart.CFrame = CFrame.new(0, -500, 0)

	task.wait(0.35)

	-- 5. Enlever le caddie (il tombe dans le vide → fling le joueur)
	character.Humanoid:UnequipTools()
	if cart and cart.Parent then
		cart:Destroy()
	end

	task.wait(0.25)

	-- 6. Te retéléporter à ta position d'origine
	if character and character:FindFirstChild("HumanoidRootPart") then
		character.HumanoidRootPart.CFrame = originalCFrame
	end

	-- Remettre visible
	task.wait(0.1)
	for _, v in pairs(character:GetDescendants()) do
		if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
			v.Transparency = 0
		elseif v:IsA("Decal") then
			v.Transparency = 0
		end
	end

	print("Fling terminé sur : " .. target.Name)
end

