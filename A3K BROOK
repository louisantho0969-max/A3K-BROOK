local KEY = "TA_CLE_ICI"                    -- ← Mets ta vraie clé ici
local DISCORD_LINK = "https://discord.gg/TON_INVITE"  -- ← Mets ton lien Discord ici

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Empêche de relancer plusieurs fois
if PlayerGui:FindFirstChild("A3K_KeySystem") or PlayerGui:FindFirstChild("A3K") then
    return
end

-- ============================================
-- SYSTÈME DE CLÉ
-- ============================================
